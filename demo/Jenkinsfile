pipeline {
    agent any

    tools {
        // Enforce the pre-configured global build tools
        maven 'maven-3.9.16'
        jdk 'jdk_21'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/venkatesh2608/newrepo.git'
            }
        }
        stage('Build') {
            steps {
                bat 'mvn clean install'
            }
        }
        stage('Test') {
            steps {
                bat 'mvn test'
            }
        }
        stage('Reports') {
            steps {
                publishHTML(target: [
                    allowMissing: false,
                    alwaysLinkToLastBuild: false,
                    keepAll: true,
                    reportDir: 'target/surefire-reports/Playwright Suite',
                    reportFiles: 'index.html',
                    reportName: 'Playwright Test Report'
                ])
            }
        }
    }
    post {
        always {
            archiveArtifacts artifacts: '**/target/surefire-reports/Playwright Suite/Headless Browser Automation.html'
        }
    }
}
